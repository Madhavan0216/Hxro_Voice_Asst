# Required: create a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional fallback keys for rate-limit rotation
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=

# Optional Spotify Developer application credentials
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional microphone tuning
# MIC_DEVICE_INDEX=
# MIC_DEVICE_NAME=
# MIC_RMS_THRESHOLD=0.00025
# POST_SPEECH_COOLDOWN=0.8
